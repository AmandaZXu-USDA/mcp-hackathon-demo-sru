# --- MCP Transport ---
MCP_TRANSPORT=stdio

# --- HTTP Server (only used when running over HTTP) ---
MCP_HOST=0.0.0.0
MCP_PORT=8000

# --- SRU Syntax Agent (injected by Databricks Apps from app resources) ---
SERVING_ENDPOINT=mas-c8629507-endpoint
AGENT_TIMEOUT_SECONDS=300
# MODEL_SERVICE=models.ai.gpt-5-6-luna
# MLFLOW_EXPERIMENT_ID=131270370350843

# --- Local runs: Databricks credentials and the UC function path ---
# DATABRICKS_HOST=https://<workspace>.cloud.databricks.com
# DATABRICKS_TOKEN=<token>   # or DATABRICKS_CLIENT_ID + DATABRICKS_CLIENT_SECRET
# SQL_WAREHOUSE_ID=<warehouse id>   # tool calls users.amanda_xu.build_sru_url (~4 s)

# --- eval/phoenix harness (see eval/phoenix/README.md) ---
# PHOENIX_COLLECTOR_ENDPOINT=http://localhost:6006
# AGENT_MODEL=databricks-gpt-5-6-luna       # agent-under-test (serving endpoint)
# JUDGE_MODEL=databricks-claude-sonnet-4-6  # LLM judges; keep it different
# AGENT_REASONING_EFFORT=none               # default "none" for gpt-5 endpoints
